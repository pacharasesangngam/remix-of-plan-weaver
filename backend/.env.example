# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
# Local HTTP only; HTTPS deployments MUST use true.
AUTH_COOKIE_SECURE=false
AUTH_FRONTEND_ORIGIN=http://localhost:8080
# Use the browser-facing origin serving /auth, including when using a reverse proxy.
AUTH_API_ORIGIN=http://localhost:8080
AUTH_DB_PATH=.data/auth.sqlite3
AUTH_SESSION_SECONDS=604800

# No account or password is built in. Generate the hash interactively: python hash_password.py
AUTH_INTERNAL_USERNAME=
AUTH_INTERNAL_PASSWORD_HASH=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated exact addresses and/or Google Workspace hosted domains. Empty denies everyone.
GOOGLE_ALLOWED_EMAILS=
GOOGLE_ALLOWED_DOMAINS=
